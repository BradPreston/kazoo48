# Turso (libsql) database
# Leave both unset to use a local SQLite file (./local.db) — no Turso
# account needed for local dev/testing. When you're ready to move to a real
# Turso database, set TURSO_DATABASE_URL to its libsql:// URL and
# TURSO_AUTH_TOKEN to its token; no code changes needed either way.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Registration fee, in cents, charged for both amateur and professional entries
REGISTRATION_FEE_CENTS=

# The show year new registrations are tagged with, so registrations can be
# filtered/reported on by year. Bump this once a year (e.g. 2027 -> 2028)
# ahead of opening registration for the next show.
SHOW_YEAR=

# Secret used to sign the cookie that proves a browser created a given
# registration (so the Step 2 resume link can't be reused by anyone who
# obtains the id). Generate one with: openssl rand -hex 32
REGISTRATION_TOKEN_SECRET=

# Postmark — used to email staff when a registration is paid (see
# lib/email/notify-registration.ts). POSTMARK_FROM_EMAIL must be a verified
# sender signature or domain address in your Postmark account.
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=

# Comma-separated list of addresses notified when a registration is paid
# (e.g. staff1@example.com,staff2@example.com)
REGISTRATION_NOTIFICATION_EMAILS=

# Bearer token for internal admin endpoints, e.g.
#   POST /api/contact-submissions/resend  { "id": "<contact_submissions id>" }
# sent with `Authorization: Bearer <ADMIN_API_KEY>`.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Google reCAPTCHA v3 — protects the contact form (see lib/recaptcha.ts).
# Create a v3 key at https://www.google.com/recaptcha/admin and add every
# domain it runs on, including `localhost` for local testing. Leave both
# unset locally to skip the check entirely; required in production.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

# Sentry — lets `next build` upload source maps so production errors have
# readable stack traces (see withSentryConfig in next.config.ts). Create an
# org auth token at https://sentry.io/settings/auth-tokens/. Leave unset
# locally; required in production.
SENTRY_AUTH_TOKEN=